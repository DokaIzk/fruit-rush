# Fruit Rush client (Vite) — copy to .env and fill in real values.

# WalletConnect / Reown project id (https://cloud.reown.com)
# Optional: MiniPay injects ethereum and does not need this.
VITE_WALLETCONNECT_PROJECT_ID=

# Public app URL — used for share links and the public boast page.
# Production builds fail if this is missing or points at localhost.
VITE_PUBLIC_APP_URL=https://fruit-rush.xyz

# Fruit Rush backend API (Render).
# ⚠ LOCAL-ONLY value: localhost fails `vite build` in production mode and is
# rejected at app startup in production. For deploys, set the Render URL:
#   VITE_API_URL=https://fruit-rush.onrender.com
VITE_API_URL=http://localhost:3000

# Magic.link publishable key (https://dashboard.magic.link)
# Used for email OTP → embedded Celo wallet. Required for email sign-in.
# If an existing deployment uses the old variable name, VITE_MAGIC_PUBLIC_KEY is supported as a compatibility alias.
VITE_MAGIC_PUBLISHABLE_KEY=

# Celo RPC (Magic / viem). Defaults below are public Forno endpoints.
# Production builds use mainnet; `npm run dev` uses the testnet URL.
VITE_CELO_RPC_URL=https://forno.celo.org
VITE_CELO_TESTNET_RPC_URL=https://alfajores-forno.celo-testnet.org

# FruitRushBoast contract (on-chain score attestations).
# Mainnet has a built-in default (0xAc9C17Eed06D935C255E5E5c668C5EF07EC79181);
# testnet is not deployed yet — set this before dev/preview mint testing.
VITE_BOAST_ADDRESS=
VITE_BOAST_ALFAJORES_ADDRESS=
