{
  "name": "fruit-rush-backend",
  "version": "1.0.0",
  "description": "Session validation and score verification microservice for Fruit Rush",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fruit-rush",
    "game-server",
    "anti-cheat",
    "session-validation",
    "celo"
  ],
  "author": "Fruit Rush Team",
  "license": "MIT",
  "dependencies": {
    "@magic-sdk/admin": "^2.5.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/node-cron": "^3.0.11",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.12",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "testcontainers": "^10.5.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
